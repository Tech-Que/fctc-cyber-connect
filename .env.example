# --- App identity (Phase 1) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FCTC Cyber Connect

# --- AI provider configuration (Phase 1 / Phase 5) ---
# Valid values: mock | ollama | openai | bedrock
AI_PROVIDER=mock

# Ollama (required when AI_PROVIDER=ollama; Phase 5+)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (required when AI_PROVIDER=openai; Phase 5+)
OPENAI_API_KEY=

# Bedrock (required when AI_PROVIDER=bedrock; Phase 5+)
AWS_BEDROCK_REGION=us-east-1

# --- Database (Phase 3) ---
# Neon Postgres pooled connection (used by Prisma at runtime)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Neon Postgres direct (non-pooled) connection — used by Prisma migrations
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (Phase 2) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
# Random 32+ char string; used for session token signing
AUTH_SECRET=

# --- Storage (later) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
